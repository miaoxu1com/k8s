# 想要取包的时间
def get_file_date():
    # 请求网页
    resu = urllib.request.urlopen(update_server, data=None, timeout=10)
    result = resu.read().decode("utf-8")
    tree = etree.HTML(result)

    # 获得当前包的列表
    container_list = tree.xpath('/html/body/ul/li/a/text()')
    for i in reversed(container_list):
        date_file = re.findall("\d{4}-\d{2}-\d{2}_\d{6}", i)  # 匹配日期
        if len(date_file) != 0:
            # print(len(date_file))
            break

    return date_file[0]


