def del_file(current_path):
    print("当前脚本的路径:%s" % current_path)
    files = [file for file in os.listdir(current_path)]
    print("当前路径下的文件：%s" % files)

    for i in os.listdir(current_path):  # 获得当前路径下的文件
        print("文件:%s" % i)
        path_file = os.path.join(current_path, i)  # 取文件绝对路径
        print("文件绝对路径为:%s" % (path_file))
        # 文件夹在删除的时候，会把本身删除掉，需要更改脚本本身文件的名字。get_package，防止被删除
        if os.path.isfile(path_file):
            if "down.py" in path_file:
                continue
            else:
                print("删除文件：%s" % path_file)
                os.remove(path_file)
        else:
            del_file(path_file)
    try:
        os.removedirs(current_path)
    except Exception as error:
        print(error)

    print("删除本地文件完成")


