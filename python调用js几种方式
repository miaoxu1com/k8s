方式一 nodejs命令行交互
import subprocess
import json

# Node.js脚本的路径
node_script_path = './generate_ids.js'

# 使用subprocess模块调用Node.js执行脚本，并捕获输出
try:
    output = subprocess.check_output(['node', node_script_path], text=True)
    # 解析输出的JSON数据
    data = json.loads(output)
    gid_value = data['gid']
    sid_value = data['sid']
    counts_value = data['counts']

    print(f"gid: {gid_value}, sid: {sid_value}, counts: {counts_value}")
except subprocess.CalledProcessError as e:
    print(f"执行Node.js脚本出错: {e}")
